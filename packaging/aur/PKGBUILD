# Maintainer: bettershot contributors
#
# Built on every packaging change by .github/workflows/packaging.yml, in an
# Arch container, against a tarball of the working tree. What that cannot
# check is the `source` URL and its checksum, because they need a release to
# point at: `sha256sums` is still a placeholder and must be filled in with
# `updpkgsums` against the real release tarball before submission.

pkgname=bettershot
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern cross-platform screenshot capture and annotation"
arch=('x86_64' 'aarch64')
url="https://github.com/bettershot/bettershot"
license=('MPL-2.0')

# libxkbcommon, wayland and libxcb are needed by the windowing layer; dbus by
# the portal client. gtk3, libayatana-appindicator and xdotool (for libxdo,
# which the tray's menu layer links) are needed only by the tray, which this
# package enables.
#
# namcap reports libxkbcommon, wayland, libxcb, dbus and
# libayatana-appindicator as "included, but may not be needed". Do not remove
# them on that basis. They are loaded with dlopen at runtime rather than
# linked, so they carry no DT_NEEDED entry for namcap to find, and dropping
# them produces a package that installs cleanly and then fails to open a
# window on the user's machine.
depends=('libxkbcommon' 'wayland' 'libxcb' 'dbus' 'gtk3' 'libayatana-appindicator' 'xdotool')
makedepends=('cargo' 'pkgconf')
optdepends=(
  'xdg-desktop-portal-wlr: screen capture on wlroots compositors'
  'xdg-desktop-portal-gnome: screen capture on GNOME'
  'xdg-desktop-portal-kde: screen capture on KDE Plasma'
  'wl-clipboard: clipboard fallback via copy-command on Wayland'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with updpkgsums

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p bettershot --features tray
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The GUI cannot be exercised in a build chroot, but every library crate's
  # tests are headless and should pass there.
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 assets/org.bettershot.Bettershot.desktop \
    "$pkgdir/usr/share/applications/org.bettershot.Bettershot.desktop"
  install -Dm644 assets/org.bettershot.Bettershot.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.bettershot.Bettershot.metainfo.xml"
  # Real PNG sizes rather than one scalable file: the logo is authored as a
  # raster, and a hand-traced SVG that drifts from it is worse than neither.
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/bettershot-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/org.bettershot.Bettershot.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # Completions and the manpage are emitted into OUT_DIR by build.rs.
  local out
  out=$(find target/release/build -name 'bettershot.1' -printf '%h\n' | head -1)
  if [[ -n "$out" ]]; then
    install -Dm644 "$out/bettershot.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
    install -Dm644 "$out/completions/$pkgname.bash" \
      "$pkgdir/usr/share/bash-completion/completions/$pkgname"
    install -Dm644 "$out/completions/$pkgname.fish" \
      "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
    install -Dm644 "$out/completions/_$pkgname" \
      "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  fi
}
