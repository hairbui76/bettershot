<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 installer definition for bettershot.

  To build it, run the `msi` job in .github/workflows/ci.yml, or copy the
  commands out of it. They are deliberately not repeated here: an XML comment
  cannot contain a double hyphen, so every command-line flag involved is
  unquotable in this file, and a paraphrase that cannot be pasted is how the
  instructions rotted the first time. CI builds this on every push, so the
  definition is verified rather than assumed.

  Every source path below is relative to the REPOSITORY ROOT, not to this
  file: WiX resolves them against the working directory, and the job builds
  from the root (which is also why BinDir is passed as target\release).

  Two things that job encodes and that are easy to get wrong:

    * `ui:WixUI` below is an extension element. Without the WiX UI extension
      registered and passed to the build, WiX fails with WIX0200; with a
      version that does not match the tool's, it fails with WIX0144 instead.
    * `license.rtf` beside this file is the MPL-2.0 text the installer's
      licence page displays, converted to RTF. Regenerate it from `LICENSE`
      if that ever changes.

  The MSI CI produces is UNSIGNED and must not be published. An unsigned
  installer trips SmartScreen on every install, which is worse for users than
  offering only the portable zip. Signing needs an Authenticode certificate
  and `signtool`; see ../README.md and docs/release-checklist.md.

  UpgradeCode must never change across versions: it is what makes an install
  an upgrade rather than a second copy. The value below is fixed for this
  product line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="bettershot"
           Manufacturer="bettershot contributors"
           Version="$(Version)"
           UpgradeCode="7f3b9c14-2e6d-4a58-9b47-0d1c8e5a2f30"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of bettershot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Shown against the shortcuts and in Installed Apps. Without it Windows
         falls back to a generic box, which is the first thing a user sees. -->
    <Icon Id="BettershotIcon" SourceFile="assets\bettershot.ico" />
    <Property Id="ARPPRODUCTICON" Value="BettershotIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hairbui76/bettershot" />

    <!-- Windows Graphics Capture needs Windows 10 1903 or later. -->
    <Launch Condition="Installed OR VersionNT >= 603"
            Message="bettershot requires Windows 10 version 1903 or later." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="bettershot" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="bettershot" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="bettershot.exe"
              Source="$(BinDir)\bettershot.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="Licence" Guid="*">
        <File Id="LICENSE" Source="LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="StartMenuShortcuts" Guid="*">
        <!-- Region capture is the common case, so that is what the Start
             menu entry does rather than opening an empty editor. -->
        <Shortcut Id="CaptureRegion"
                  Name="bettershot"
                  Description="Capture a region and annotate it"
                  Target="[INSTALLFOLDER]bettershot.exe"
                  Arguments="--capture region"
                  Icon="BettershotIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="RunResident"
                  Name="bettershot (stay resident)"
                  Description="Run in the tray with global hotkeys"
                  Target="[INSTALLFOLDER]bettershot.exe"
                  Arguments="--daemon"
                  Icon="BettershotIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\bettershot"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- A capture tool is only useful if it is already running when you want
         it: the hotkey has to be live *before* the thing you want to capture
         is on screen. So the daemon starts at login, in the background, with
         the tray icon as its only presence.

         A per-user Run value rather than a service or a Startup-folder
         shortcut: it needs no elevation, it is where users look for
         auto-starting apps (Task Manager's Startup tab lists it and can
         disable it), and Windows removes it with the product.

         Its own feature so it can be declined on the installer's feature page
         (which is why this uses WixUI_FeatureTree and not WixUI_Minimal, whose
         two-click flow has nowhere to offer the choice), or turned off later
         from Installed Apps > Modify. -->
    <ComponentGroup Id="Autostart" Directory="INSTALLFOLDER">
      <Component Id="RunAtLogin" Guid="*">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="bettershot"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]bettershot.exe&quot; --daemon"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="bettershot" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="Shortcuts" />

      <Feature Id="AutostartFeature"
               Title="Start in the background at login"
               Description="Keeps bettershot resident so its global hotkey works straight away. Shows a tray icon."
               Level="1">
        <ComponentGroupRef Id="Autostart" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\windows\license.rtf" />
  </Package>
</Wix>
